{
  "name": "shwe-kokko-myawaddy-marketplace-bot",
  "version": "1.0.0",
  "description": "Telegram second-hand marketplace bot for Shwe Kokko and Myawaddy",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "build": "tsc",
    "start": "node dist/bot.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19.0 <22.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/config": "^7.0.0",
    "@sentry/node": "^11.1.0",
    "@telegraf/session": "^2.0.0-beta.7",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "https-proxy-agent": "^9.1.0",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "socks-proxy-agent": "^10.1.0",
    "telegraf": "^4.16.3",
    "telegraf-throttler": "^0.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  }
}
