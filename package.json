{
  "name": "shwe-kokko-myawaddy-marketplace-bot",
  "version": "1.0.0",
  "description": "Telegram second-hand marketplace bot for Shwe Kokko and Myawaddy",
  "main": "dist/bot.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bot.ts",
    "build": "prisma generate && tsc --noIncremental",
    "start": "node dist/bot.js",
    "typecheck": "npx tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/config": "^7.0.0",
    "@telegraf/session": "^2.0.0-beta.7",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "https-proxy-agent": "^9.1.0",
    "pg": "^8.13.1",
    "socks-proxy-agent": "^10.1.0",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "prisma": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  }
}
