generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}


enum ListingStatus {
  PENDING
  APPROVING
  APPROVED
  REJECTED
}

enum ListingAvailability {
  AVAILABLE
  SOLD_OUT
}

model Listing {
  id               String              @id @default(uuid())
  sellerTelegramId BigInt              @map("seller_telegram_id")
  sellerUsername   String?             @map("seller_username")
  sellerFirstName  String?             @map("seller_first_name")
  productName      String              @map("product_name")
  category         String
  location         String
  priceAmount      Float               @map("price_amount")
  currency         String
  condition        String
  note             String?
  contact          String
  photoFileIds     String[]            @map("photo_file_ids")
  status           ListingStatus       @default(PENDING)
  availability     ListingAvailability @default(AVAILABLE)
  rejectionReason  String?             @map("rejection_reason")
  channelMessageId BigInt?             @map("channel_message_id")
  submissionKey String? @unique @map("submission_key")
  
  originalData     Json?               @map("original_data")

  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([status])
  @@index([availability])
  @@index([sellerTelegramId])
  @@index([createdAt])
  @@map("listings")
}

model TelegramSession {
  key       String   @id
  session   Json
  expiresAt DateTime? @map("expires_at")

  @@map("telegram_sessions")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}