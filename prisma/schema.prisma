generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  PENDING
  APPROVING
  APPROVED
  REJECTED
}

enum ListingAvailability {
  AVAILABLE
  SOLD_OUT
}

model Listing {
  // --- Primary Keys ---
  id       String @id @default(uuid())
  publicId String @unique @map("public_id")

  // --- Seller Info ---
  sellerTelegramId BigInt  @map("seller_telegram_id")
  sellerUsername   String? @map("seller_username")
  sellerFirstName  String? @map("seller_first_name")

  // --- Listing Data ---
  productName  String   @map("product_name")
  category     String
  location     String
  priceAmount  Float    @map("price_amount")
  currency     String
  condition    String
  note         String?
  contact      String
  photoFileIds String[] @map("photo_file_ids")

  // --- State & Status ---
  status          ListingStatus       @default(PENDING)
  availability    ListingAvailability @default(AVAILABLE)
  rejectionReason String?             @map("rejection_reason")

  // --- Telegram Integration ---
  channelMessageId BigInt? @map("channel_message_id")

  // --- Reliability & Tracking Fields ---
  submissionKey       String?   @unique @map("submission_key")
  adminGroupSentAt    DateTime? @map("admin_group_sent_at") // Prevents lost listings
  adminGroupMessageId BigInt?   @map("admin_group_message_id") // Tracks admin control message
  approvalStartedAt   DateTime? @map("approval_started_at") // Tracks stuck approvals

  // --- Audit & Original Data ---
  originalData Json?    @map("original_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // --- Indexes ---
  @@index([status])
  @@index([availability])
  @@index([sellerTelegramId])
  @@index([createdAt])
  @@map("listings")
}

model TelegramSession {
  key       String    @id
  session   Json
  expiresAt DateTime? @map("expires_at")

  @@index([expiresAt])
  @@map("telegram_sessions")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
